# ============================================================================
# Dump Sniper — 精简版配置 (clean baseline)
# ============================================================================
# 复制为 .env，填入最下方【密钥区】即可；策略字段已按目标规则设好。
# ⚠️ 首次部署保持 DRY_RUN=true，确认有信号、买卖正常后再切 LIVE。
# ============================================================================

# ============ 运行模式 ============
DRY_RUN=true
POSITION_SIZE_SOL=0.2

# ============ 买入：迁移15-25秒内首次满足的早期资金流 ============
EARLY_FLOW_ENABLED=true
EARLY_FLOW_MIN_AGE_MS=15000
EARLY_FLOW_MAX_AGE_MS=25000
EARLY_FLOW_MIN_FDV_USD=15000
EARLY_FLOW_MAX_FDV_USD=100000
EARLY_FLOW_SOL_PRICE_USD=75.5
EARLY_FLOW_PRICE_WINDOW_MS=10000
EARLY_FLOW_MIN_PRICE_CHANGE_PCT=-10
EARLY_FLOW_MAX_PRICE_CHANGE_PCT=8
EARLY_FLOW_NET_FLOW_WINDOW_MS=1000
EARLY_FLOW_ACTIVITY_WINDOW_MS=5000
EARLY_FLOW_MIN_UNIQUE_BUYERS=3
EARLY_FLOW_MIN_TRADE_COUNT=4
EARLY_FLOW_MIN_BUY_SOL_5S=2
EARLY_FLOW_MAX_LARGEST_BUY_SHARE=0.70
EARLY_FLOW_EXECUTION_WINDOW_MS=3000
EARLY_FLOW_MAX_EXECUTION_PRICE_DEVIATION_PCT=15
EARLY_FLOW_MARKET_FRESH_MS=1500

# ============ Live composite entry-risk filter ============
# Each weak feature adds one point. A score of 4 or more rejects the BUY.
EARLY_FLOW_RISK_FILTER_ENABLED=true
EARLY_FLOW_RISK_REJECT_SCORE=4
EARLY_FLOW_RISK_MIN_UNIQUE_BUYERS_5S=6
EARLY_FLOW_RISK_MIN_BUY_SOL_5S=3
EARLY_FLOW_RISK_MIN_PRICE_CHANGE_PCT=-2
EARLY_FLOW_RISK_MAX_LARGEST_BUY_SHARE=0.45
EARLY_FLOW_RISK_MAX_EXECUTION_DELAY_MS=400
EARLY_FLOW_RISK_MIN_FDV_USD=25000
EARLY_FLOW_RISK_MAX_MIGRATION_AGE_MS=20000

# ============ 卖出：EMA辅助 + 移动止盈 + FDV应急 ============
EARLY_FLOW_EMA_EXIT_ENABLED=true
EARLY_FLOW_EMA_FAST_PERIOD=9
EARLY_FLOW_EMA_SLOW_PERIOD=20
EARLY_FLOW_EMA_BAR_MS=15000
EARLY_FLOW_EMA_RESET_GAP_MS=300000
EARLY_FLOW_EMA_EXECUTION_DELAY_MS=500
EARLY_FLOW_TRAILING_ACTIVATE_PCT=9
EARLY_FLOW_TRAILING_DRAWDOWN_PCT=5
EARLY_FLOW_FDV_EXIT_USD=10000
EARLY_FLOW_FIXED_STOP_LOSS_PCT=0

# Fixed and confirmed-tail stops are hard-disabled in code.
EARLY_FLOW_TAIL_STOP_ENABLED=false
EARLY_FLOW_TAIL_STOP_PNL_PCT=-30
EARLY_FLOW_TAIL_STOP_CONFIRM_MS=500
EARLY_FLOW_TAIL_STOP_CONFIRM_TRADES=2

# A trusted post-buy swap at or below -50% exits immediately, even if trailing armed.
EARLY_FLOW_CATASTROPHIC_STOP_ENABLED=true
EARLY_FLOW_CATASTROPHIC_STOP_PNL_PCT=-50

EARLY_FLOW_SLOW_BLEED_EXIT_ENABLED=true
EARLY_FLOW_SLOW_BLEED_MIN_HOLD_MS=60000
EARLY_FLOW_SLOW_BLEED_MAX_PEAK_PNL_PCT=9
EARLY_FLOW_SLOW_BLEED_MAX_PNL_PCT=-5
EARLY_FLOW_SLOW_BLEED_FLOW_WINDOW_MS=3000
EARLY_FLOW_SLOW_BLEED_SELL_BUY_RATIO=1.5
EARLY_FLOW_SLOW_BLEED_MAX_UNIQUE_BUYERS=2
EARLY_FLOW_SLOW_BLEED_CONFIRM_MS=500
EARLY_FLOW_SLOW_BLEED_CONFIRM_TRADES=2

# ============ Post-entry invalidation (not a fixed stop) ============
EARLY_WRONG_EXIT_ENABLED=true
# shadow=record only, never sell; live=allow EARLY_ENTRY_INVALIDATED sells
EARLY_WRONG_EXIT_MODE=shadow
EARLY_WRONG_EXIT_MIN_HOLD_MS=3000
EARLY_WRONG_EXIT_MAX_HOLD_MS=15000
EARLY_WRONG_EXIT_MAX_PEAK_PNL_PCT=3
EARLY_WRONG_EXIT_PRICE_BREAK_PCT=-3
EARLY_WRONG_EXIT_FLOW_WINDOW_MS=3000
EARLY_WRONG_EXIT_SELL_BUY_RATIO=1.5
EARLY_WRONG_EXIT_MAX_UNIQUE_BUYERS=1
EARLY_WRONG_EXIT_CONFIRM_MS=500
EARLY_WRONG_EXIT_CONFIRM_TRADES=2

# Real add-ons remain disabled.
ADDON_ENABLED=0

# Research-only add-on shadow. No chain BUY/SELL is submitted.
ADDON_SHADOW_ENABLED=true
ADDON_SHADOW_WINDOW_MS=60000
ADDON_SHADOW_LOW_PNL_PCT=-20
ADDON_SHADOW_MIN_CURRENT_PNL_PCT=-20
ADDON_SHADOW_MAX_CURRENT_PNL_PCT=0
ADDON_SHADOW_MIN_REBOUND_PCT=3
ADDON_SHADOW_MIN_NET_FLOW_3S_SOL=0
ADDON_SHADOW_MIN_BUY_SELL_RATIO_3S=1.5
ADDON_SHADOW_MIN_UNIQUE_BUYERS_3S=2
ADDON_SHADOW_MIN_TRADE_COUNT_3S=6
ADDON_SHADOW_MAX_TRADE_COUNT_3S=16
ADDON_SHADOW_MIN_BUY_ACCELERATION_3S=3
ADDON_SHADOW_SIZE_SOL=0.2
ADDON_SHADOW_MAX_HOLD_MS=1500000
ADDON_SHADOW_TRAILING_ACTIVATE_PCT=50
ADDON_SHADOW_TRAILING_DRAWDOWN_PCT=10
ADDON_SHADOW_EXECUTION_COST_PCT=5

# ============ 监控列表过滤（链上 FDV/LP 实时过滤；外部行情每 1min 补充）============
#   FDV $1.5万~$100万 或 LP <$3000 移除 / 24h量 <$5000 移除 / 迁移 AGE >30min 先平仓再移除
MIN_FDV_USD=15000
MAX_FDV_USD=1000000
MIN_LIQUIDITY_USD=3000
MIN_VOLUME_24H_USD=5000
# TOKEN_MAX_AGE_MS 已废弃；代码会忽略旧部署中的该变量。
BURST_WATCHLIST_MAX_AGE_MS=1800000
WATCHDOG_AGE_CHECK_INTERVAL_MS=1000
MAX_MINT_AGE_HOURS=0
NEW_COIN_AGE_THRESHOLD_MS=0
# Values above 60000 are clamped so FDV/LP and AGE resolution still run every minute.
WATCHDOG_CHECK_INTERVAL_MS=60000
WATCHDOG_REALTIME_MARKET_PERSIST_MS=1000
WATCHDOG_MARKET_STALE_MS=180000
WATCHDOG_MARKET_BATCH_SIZE=30
WATCHDOG_MARKET_BATCH_DELAY_MS=250
WATCHDOG_MARKET_FALLBACK_MAX_PER_CYCLE=10
MAX_WATCHED_TOKENS=500

# ============ Pump.fun graduation discovery ============
# WebSocket detects migrate immediately; migration-wallet polling fills gaps.
# Admission checks FDV/LP plus the migration slot audit below.
# AGE starts from the confirmed migration time.
PUMP_DISCOVERY_ENABLED=true
PUMP_DISCOVERY_WS_URL=
PUMP_DISCOVERY_POLL_INTERVAL_MS=5000
PUMP_DISCOVERY_POLL_LIMIT=100
PUMP_DISCOVERY_POLL_MAX_PAGES=20
PUMP_DISCOVERY_WS_RECOVERY_SILENCE_MS=30000
PUMP_DISCOVERY_STARTUP_LOOKBACK_SEC=120
PUMP_DISCOVERY_MARKET_INITIAL_DELAY_MS=2000
PUMP_DISCOVERY_MARKET_RETRIES=8
PUMP_DISCOVERY_MARKET_RETRY_MS=3000
PUMP_DISCOVERY_MAX_CONCURRENT_CHECKS=3
# Full-block audit: Migrate-10 slots through the slot where discovery observed it.
# Uses target-mint instructions plus pre/post token-balance deltas, including same-slot txs.
# Fail closed when the complete range cannot be verified.
PUMP_DISCOVERY_AUDIT_ENABLED=true
PUMP_DISCOVERY_AUDIT_PRE_SLOTS=10
PUMP_DISCOVERY_AUDIT_LARGE_TRANSFER_TOKENS=100000000
PUMP_DISCOVERY_AUDIT_LARGE_TRANSFER_SUPPLY_PCT=5
PUMP_DISCOVERY_AUDIT_RPC_CONCURRENCY=6
PUMP_DISCOVERY_AUDIT_RPC_RETRIES=3
PUMP_DISCOVERY_AUDIT_BLOCK_CACHE_MS=120000
PUMP_DISCOVERY_AUDIT_BLOCK_CACHE_MAX_SLOTS=32
PUMP_DISCOVERY_AUDIT_FAIL_CLOSED=true

# ============ 仓位与价格数据保护 ============
MAX_CONCURRENT_POSITIONS=60
PRICE_MAX_JUMP_RATIO=1.5
PRICE_CONFIRM_WINDOW_MS=3000
PRICE_CONFIRM_MIN_SAMPLES=2
POSITION_MAX_JUMP_RATIO=5
POSITION_EXTREME_RATIO=50

# ============ Pool 状态缓存（零延迟买入路径，勿改）============
POOL_POLL_INTERVAL_MS=500
POOL_STATE_POSITION_REFRESH_MS=500
POOL_STATE_SIGNAL_REFRESH_MS=2000
POOL_STATE_WATCHED_REFRESH_MS=60000
# 0 = auto-size batches so every active watched pool is refreshed within the interval above.
POOL_STATE_WATCHED_BATCH_SIZE=0
POOL_STATE_TICK_MS=200
AUTO_FILL_POOLS_ON_START=true

# ============ 滑点 / 优先费 / Jito ============
# exact-quote 买入固定 SOL 支出；该值限制最少到手代币数，且不会突破价格上限。
BUY_SLIPPAGE_BPS=5000
BUY_MAX_PRICE_DEVIATION_PCT=15
# 强制刷新关闭时，才允许复用不超过该年龄的池状态。
BUY_MAX_POOL_STATE_AGE_MS=500
# 默认强制在每次 BUY 构造前读取最新池状态。
BUY_FORCE_FRESH_POOL_STATE=true
SELL_SLIPPAGE_BPS=500
PRIORITY_FEE_DYNAMIC=false
BUY_PRIORITY_LEVEL=veryHigh
SELL_PRIORITY_LEVEL=medium
BUY_MIN_PRIORITY_FEE_LAMPORTS=500000
SELL_MIN_PRIORITY_FEE_LAMPORTS=500000
BUY_CAP_PRIORITY_FEE_LAMPORTS=500000
SELL_CAP_PRIORITY_FEE_LAMPORTS=500000
BUY_MAX_PRIORITY_FEE_LAMPORTS=500000
SELL_MAX_PRIORITY_FEE_LAMPORTS=500000
MAX_PRIORITY_FEE_LAMPORTS=500000
PRIORITY_FEE_REFRESH_MS=500
JITO_TIP_LAMPORTS=200000
COMPUTE_UNIT_LIMIT=250000

# ============ 杂项 / 稳定性 ============
MAX_REPLAY_SLOTS=5            # LaserStream 重连最多回放 5 slot（防 RSS 死亡螺旋）。勿改
LS_LAG_RECONNECT_THRESHOLD_SLOTS=100
LS_LAG_RECONNECT_SUSTAINED_MS=10000
LS_LAG_RECONNECT_COOLDOWN_MS=30000
MEMORY_RESTART_STARTUP_GRACE_MS=120000
MEMORY_RESTART_CONFIRM_SAMPLES=3
MAX_UPTIME_MS=10800000        # 空仓时每 3h 自动重启释放 native 内存
COMPETITOR_ENRICH=false
COMPETITOR_FOLLOW_SELL=false
SWAP_EVENT_LOG_ENABLED=true
POSITION_RESEARCH_LOG_ENABLED=true
POSITION_RESEARCH_WINDOW_MS=10000
POSITION_RESEARCH_FLUSH_MS=250
POSITION_RESEARCH_FLUSH_MAX=1000

# ============================================================================
# 【密钥区】—— 必填，从旧服务器 .env 复制 ——
# ============================================================================
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_STAKED_RPC_URL=
HELIUS_SENDER_ENDPOINT=https://sender.helius-rpc.com/fast
HELIUS_SENDER_ENDPOINTS=http://fra-sender.helius-rpc.com/fast,http://ewr-sender.helius-rpc.com/fast,http://tyo-sender.helius-rpc.com/fast
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-fra.helius-rpc.com
HELIUS_LASERSTREAM_ENDPOINTS=https://laserstream-mainnet-fra.helius-rpc.com,https://laserstream-mainnet-ewr.helius-rpc.com,https://laserstream-mainnet-tyo.helius-rpc.com
HELIUS_LASERSTREAM_TOKEN=
BIRDEYE_API_KEY=
WALLET_PRIVATE_KEY_BS58=

# ============ Dashboard ============
DASHBOARD_PORT=3001
BIND_HOST=0.0.0.0
WEBHOOK_SECRET=
DASHBOARD_TOKEN=
